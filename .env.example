# Copy to .env and fill in real keys. The scriptling CLI auto-loads .env
# from the working directory at startup. LOCAL_API_KEY can stay dummy for
# keyless local servers (Ollama ignores it); it is only sent as a Bearer
# token when non-empty.

ANTHROPIC_API_KEY=sk-ant-your-key-here
GEMINI_API_KEY=your-key-here
ZAI_API_KEY=your-key-here
LOCAL_API_KEY=ollama
